{
  "name": "gpx-terrain-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "build:server": "vite build --ssr src/server/index.ts --outDir server-dist --emptyOutDir",
    "start": "node server-dist/index.js",
    "test": "tsx --test src/server/index.test.ts src/server/generate-terrain.test.ts src/server/elevation/*.test.ts src/core/*.test.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
